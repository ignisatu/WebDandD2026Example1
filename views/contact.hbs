<style>
		:root {
			--main: #899DFF;
			--light: #A5C2FF;
			--dark: #7F7CFF;
			--altmain: #AAA3FF;
			--black: #333;
		}

		/* Using a flexbox to centre the items */
		.centre {
			margin-top: 100px;
			display: flex;
			justify-content: center;
			align-items: center;
			width: 100%;

		}

		/* flexbox to organise each field */
		/* rem = base font size*/
		fieldset {
			display: flex;
			flex-direction: column;
			gap: 5px;
			margin-bottom: 1rem;
			border: 0px;

		}
		fieldset label,
		fieldset legend {
			font-size: 14px;
			font-weight: 500;
			color: var(--black);
		}

		/*we do not want to include the radios
		box sizing: border-box makes it so that padding is included in the calculation of widith and height*/
		fieldset input[type="text"],
		fieldset input[type="email"],
		fieldset input[type="tel"] {
			padding: 8px 12px;
			border: 2px solid var(--light);
			border-radius: 5px;
			font-size: 15px;
			width: 100%;
			box-sizing: border-box;
		}

		.radio-group {
			display: flex;
			flex-direction: column;
			gap: 8px;
		}

		.radio-group label {
			display: flex;
			align-items: center;
			gap: 8px;
			cursor: pointer;
		}



		.required {
			color: red;
		}
	</style>	
	<main>
		<section class="centre">

			<form action="http://foo.com" method="get">
				<h2>Contact Us</h2>
				<fieldset>
					<label for="name">Full name:<span class="required">*</span></label>
					<input type="text" id="name" name="name" autofocus required>
				</fieldset>
				<fieldset>
					<label for="email">Email:<span class="required">*</span></label>
					<input type="email" id="email" name="email" placeholder="email@example.com" required>
				</fieldset>

				<fieldset>
					<label for="phone">Phone:</label>
					<input type="tel" id="phone" name="phone">
				</fieldset>

				<fieldset>
					<legend>Reason for contact:</legend>
					<div class="radio-group">
						<label><input type="radio" name="reason" id="question" value="question"
								checked>Question</label>
						<label><input type="radio" name="reason" id="submission"
								value="submission">Submission of
							an Artefact</label>
						<label><input type="radio" name="reason" id="partnership"
								value="partnership">Partnership</label>
						<label><input type="radio" name="reason" id="other" value="other">Other</label>
					</div>
				</fieldset>

				<fieldset>
					<label for="message">Message:<span class="required">*</span></label>
					<textarea id="message" name="message" required></textarea>
				</fieldset>


				<input class="button" type="submit" name="submit" value="submit">
				<input class="button" type="reset" name="reset" value="reset">


			</form>
		</section>

	</main>